{
  "name": "@workspace/api-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "export NODE_ENV=development && pnpm run build && pnpm run start",
    "build": "node ./build.mjs",
    "start": "node --enable-source-maps ./dist/index.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import ../../scripts/node_modules/tsx/dist/loader.mjs --test src/lib/aiJobAnalyzer.test.ts src/lib/jobCountry.test.ts src/lib/jobFeedOrder.test.ts src/lib/jobIdentity.test.ts src/lib/jobReconciliation.test.ts src/lib/matching.test.ts src/lib/premiumTrial.test.ts src/lib/reviewOtp.test.ts src/lib/scraperLock.test.ts src/lib/sessionPolicy.test.ts ../../scripts/jobCategory.test.mjs",
    "test:premium-sandbox": "node ./scripts/test-premium-sandbox.mjs",
    "test:review-auth": "NODE_ENV=development RUN_LOCAL_AUTH_TESTS=1 node --import ../../scripts/node_modules/tsx/dist/loader.mjs src/lib/reviewAuth.integration.ts"
  },
  "dependencies": {
    "@types/multer": "^2.2.0",
    "@types/node-cron": "^3.0.11",
    "@workspace/api-zod": "workspace:*",
    "@workspace/db": "workspace:*",
    "@workspace/job-categories": "workspace:*",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "drizzle-orm": "catalog:",
    "express": "^5.2.1",
    "firebase-admin": "^14.3.0",
    "mammoth": "^1.12.0",
    "multer": "^2.2.0",
    "node-cron": "^4.6.0",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "catalog:",
    "esbuild": "0.27.3",
    "esbuild-plugin-pino": "^2.3.3",
    "pino-pretty": "^13.1.3",
    "thread-stream": "3.1.0"
  }
}
